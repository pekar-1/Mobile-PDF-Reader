# PDFium JNI: native code looks these classes up by name (RegisterNatives,
# FindClass), so their names and native methods must survive R8.
-keep class com.example.pdf_reader.pdfium.jni.*Native {
    native <methods>;
}
-keep class com.example.pdf_reader.pdfium.PdfiumException {
    <init>(java.lang.String, int);
}