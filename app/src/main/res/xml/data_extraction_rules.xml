<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12 (API 31) and higher.
   The library DB stores content:// URIs whose read permissions do not survive a restore
   or a move to another device, and thumbnails are derived from those documents.
   Keep in sync with backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="pdf_reader.db" />
        <exclude domain="database" path="pdf_reader.db-wal" />
        <exclude domain="database" path="pdf_reader.db-shm" />
        <exclude domain="file" path="thumbs/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="pdf_reader.db" />
        <exclude domain="database" path="pdf_reader.db-wal" />
        <exclude domain="database" path="pdf_reader.db-shm" />
        <exclude domain="file" path="thumbs/" />
    </device-transfer>
</data-extraction-rules>
